# SecFlow Demo Customer Application - Environment Configuration Example
# Copy this file to .env before starting services in development mode.

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://postgres:replace_with_secure_password@postgres:5432/ecommerce

# Backend Authentication & Security
SECRET_KEY=replace_with_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Demo Credentials for Test Accounts
DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
DEMO_USER_PASSWORD=replace_with_demo_user_password

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development

# Storage Options
# Leave GCS_BUCKET_NAME blank to use local persistent filesystem storage (/uploads)
GCS_BUCKET_NAME=
